# ==============================================================================
# POKKETFIT ENVIRONMENT CONFIGURATION (EXAMPLE TEMPLATE)
# Copy this file to .env.local and replace with your real credentials.
# ==============================================================================

# 1. Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=pokketfit_exercise_videos

# 3. Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:coach@pokketfit.app

# 4. Email (Resend)
RESEND_API_KEY=your-resend-api-key-here

# 5. Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_STRATEGY=AUTO_ACCEPT
CRON_SECRET=pokketfit_cron_internal_secret_key
